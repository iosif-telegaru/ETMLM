{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ETMLM",
  "scopeName": "text.xml.etmlm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#ttml-tags"
    },
    {
      "include": "#custom-tags"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#lyrics"
    }
  ],
  "repository": {
    "comments": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.xml"
    },
    "ttml-tags": {
      "comment": "Tags 'de toda la vida' del TTML clásico, incluyendo el namespace ttm: usado por metadata (agent/name)",
      "match": "(</?)(tt|head|body|div|p|span|br|metadata|title|region|style|layout|set|ttm:agent|ttm:name)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.ttml.etmlm"
        },
        "2": {
          "name": "entity.name.tag.ttml.etmlm"
        }
      }
    },
    "custom-tags": {
      "comment": "Cualquier otro tag (nuevo, personalizado de ETMLM) cae aquí automáticamente, sin necesidad de listarlo a mano. Soporta puntos, guiones y namespaces con ':' (ej. pre.span, body.edit, composer:meta, brighten.word).",
      "match": "(</?)([a-zA-Z_][a-zA-Z0-9_.:-]*)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.custom.etmlm"
        },
        "2": {
          "name": "entity.name.tag.custom.etmlm"
        }
      }
    },
    "attributes": {
      "comment": "Nombres de atributos antes del '=', incluye namespaces (xml:lang, xmlns:composer, xml:id, etc.)",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_.:-]*)(?=\\s*=)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.xml"
        }
      }
    },
    "operators": {
      "match": "=",
      "name": "keyword.operator.assignment.xml"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.xml"
    },
    "lyrics": {
      "comment": "Texto/letra entre > y <",
      "match": "(?<=>)[^<]+(?=<)",
      "name": "string.unquoted.lyrics.etmlm"
    }
  }
}
