{
    "comments": {
        "blockComment": [ "<!--", "-->" ]
    },
    "brackets": [
        ["<", ">"]
    ],
    "autoClosingPairs": [
        { "open": "<!--", "close": "-->" },
        { "open": "<", "close": ">" },
        { "open": "\"", "close": "\"" }
    ],
    "surroundingPairs": [
        ["<", ">"],
        ["\"", "\""]
    ],
    "wordPattern": "[a-zA-Z_][a-zA-Z0-9_.:-]*",
    "indentationRules": {
        "increaseIndentPattern": "<(?!\\?|[^>]*/>)([-_.:a-zA-Z0-9]+)(?:(?!/>)[^>])*>[^<]*$",
        "decreaseIndentPattern": "^\\s*</([-_.:a-zA-Z0-9]+)\\b[^>]*>"
    },
    "folding": {
        "markers": {
            "start": "^\\s*<(?!\\?|[^>]*/>)([-_.:a-zA-Z0-9]+)\\b[^>]*>\\s*$",
            "end": "^\\s*</([-_.:a-zA-Z0-9]+)\\s*>\\s*$"
        }
    }
}
